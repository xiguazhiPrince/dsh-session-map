{
  "name": "dsh-session-map",
  "version": "0.2.0",
  "description": "Session map: a turn-tree canvas over every DSH session — users' turns are nodes, sessions are coloured lines and tags, and forks leave from the exact inherited turn — as a Conversation tab and two right-sidebar tabs",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
