{
  "name": "@xiguazhiprince/dsh-session-map",
  "version": "0.3.0",
  "description": "Session map: a turn-tree canvas over every DSH session — users' turns are nodes, sessions are coloured lines and tags, and forks leave from the exact inherited turn — as a Conversation tab and two right-sidebar tabs. Also adds a Settings → Clone from Git page that clones a repository and registers the directory as a workspace",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "author": "xiguazhiPrince",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "fork-tree",
    "visualization",
    "git"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiguazhiPrince/dsh-session-map.git"
  },
  "homepage": "https://github.com/xiguazhiPrince/dsh-session-map#readme",
  "bugs": {
    "url": "https://github.com/xiguazhiPrince/dsh-session-map/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
