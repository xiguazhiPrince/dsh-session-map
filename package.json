{
  "name": "@xiguazhiprince/dsh-session-map",
  "version": "0.5.0",
  "description": "Session map, BTW forks, skills and AGENTS.md panels, an IntelliJ-style Git tool window, and quote-to-chat from file previews for DeepSeek Harness: draw each session's turn-fork tree, fork the running session at its exact progress into a read-only copy, see the skills and instruction files a session really uses, quote a right-sidebar file selection (absolute path + line range + source excerpt) into the composer, and stage, commit, push, update or clone a repository without leaving the GUI.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "author": "xiguazhiPrince",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "fork-tree",
    "visualization",
    "git",
    "quote",
    "selection",
    "source-reference"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiguazhiPrince/dsh-session-map.git"
  },
  "homepage": "https://github.com/xiguazhiPrince/dsh-session-map#readme",
  "bugs": {
    "url": "https://github.com/xiguazhiPrince/dsh-session-map/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
